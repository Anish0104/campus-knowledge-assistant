# Optional overrides for config.py defaults. Export them in your shell,
# e.g. `set -a; source .env.example; set +a`, before running a script.
# Optional overrides for config.py defaults.
# Copy to .env or export in your shell before running scripts.

# LLM provider: 'ollama' (default) or 'groq'
LLM_PROVIDER=ollama

# Local Ollama settings
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120

# Cloud Groq settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_COMPLETION_TOKENS=2048
